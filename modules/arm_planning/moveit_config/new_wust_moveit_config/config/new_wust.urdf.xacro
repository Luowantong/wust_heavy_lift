<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="new_wust">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import new_wust urdf file -->
    <xacro:include filename="$(find new_wust_description)/urdf/robot.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="new_wust.ros2_control.xacro" />


    <xacro:new_wust_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
