<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="wust_seven_axis_arm_description">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import wust_seven_axis_arm_description urdf file -->
    <xacro:include filename="$(find wust_seven_axis_arm_description)/urdf/wust_seven_axis_arm.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="wust_seven_axis_arm_description.ros2_control.xacro" />


    <xacro:wust_seven_axis_arm_description_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
