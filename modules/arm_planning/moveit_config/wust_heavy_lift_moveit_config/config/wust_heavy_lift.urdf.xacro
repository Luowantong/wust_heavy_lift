<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="wust_heavy_lift">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import wust_heavy_lift urdf file -->
    <xacro:include filename="$(find wust_heavy_lift_description)/urdf/robot.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="wust_heavy_lift.ros2_control.xacro" />


    <xacro:wust_heavy_lift_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
