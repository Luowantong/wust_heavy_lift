  <contact>
    <exclude body1="world" body2="link1" />
    <exclude body1="world" body2="link5" />
    <exclude body1="world" body2="link6" />
    <exclude body1="link1" body2="link2" />
    <exclude body1="link2" body2="link3" />
    <exclude body1="link3" body2="link4" />
    <exclude body1="link4" body2="link5" />
    <exclude body1="link5" body2="link6" />
    <exclude body1="link6" body2="link7" />
    <exclude body1="link5" body2="link7" />
    <exclude body1="link5" body2="hollow_cylinder" />
    <exclude body1="link6" body2="hollow_cylinder" />
    <exclude body1="link7" body2="hollow_cylinder" />
    <exclude body1="link2" body2="link4" />
    <!-- 注意：hollow_cylinder ↔ E 不排除。孔壁(Ø39.8) ↔ 兑换柱(Ø36) 要靠接触
         导正，孔底 ↔ 柱尖/法兰靠接触限位。站体的 CAD 网格本身 contype=0，
         真正参与接触的只有 E_coll_collar/peg/tip 和 E_coll_base，
         而座位处单元末端 (-0.098) 距 E_coll_base (-0.11) 还有 12 mm。 -->
  </contact>
  <equality>
    <weld name="rest" body1="world" body2="hollow_cylinder"
      relpose="0.34 0 0.28 1 0 0 0" active="false"/>
    <!-- 夹持约束故意留软：solref 默认 0.02 1，20 N 侧向力下约 12 mm 偏移。
         单元插进柱子时孔壁/法兰会真实顶住，这点柔性让夹爪"让位"，
         而不是像刚体焊死那样把柱子一起推开。 -->
    <weld name="grasp" body1="link7" body2="hollow_cylinder"
      relpose="-0.096 -0.075 0.159 0.27543 -0.40581 -0.09889 -0.86584" active="false"/>
</equality>
  <actuator>
    <position name="pos_J1" joint="joint1" kp="300" kv="3" ctrllimited="true" ctrlrange="-3.14 3.14" forcelimited="true" forcerange="-40 40" />
