      <geom name="hollow_wall_8"  type="box" pos="-0.02620 0.00000 0.02250" size="0.00630 0.00646 0.05250" quat="0.000000 0 0 1.000000" contype="1" conaffinity="1" rgba="0.8 0.5 0.2 0.35"/>
