      <geom name="hollow_wall_15" type="box" pos="0.02421 -0.01003 0.02250" size="0.00630 0.00646 0.05250" quat="-0.980785 0 0 0.195090" contype="1" conaffinity="1" rgba="0.8 0.5 0.2 0.35"/>
      <!-- 孔底端板：柱尖顶到 z=-0.030 就到底了 -->
      <geom name="hollow_bore_bottom" type="cylinder" pos="0 0 -0.034" size="0.0199 0.004"
            contype="1" conaffinity="1" rgba="0.8 0.5 0.2 0.35"/>
      <!-- 孔以下的实心部分 -->
      <geom name="hollow_back" type="cylinder" pos="0 0 -0.0525" size="0.0325 0.0225"
            contype="1" conaffinity="1" rgba="0.8 0.5 0.2 0.35"/>
      <!-- 真单元视觉：平移到几何中心、轴心；绕 x 转 -90° 使开口端(+y→+z)朝站体 -->
      <geom name="energy_unit_visual" type="mesh" mesh="energy_unit_visual" class="visual"
            pos="-0.0475 -0.04747 0.075" quat="0.7071068 -0.7071068 0 0"
            rgba="0.85 0.9 0.95 1" />
    </body>
    <geom pos="0 0 0" quat="1 0 0 0" type="mesh" rgba="1 1 1 1" mesh="base_collision" group="3" />
    <geom name="base_visual" class="visual" mesh="base_visual" rgba="1 1 1 1" />
    <!-- gravcomp="1"：模拟真实控制器的重力补偿（电控组确认有）。
         不加的话 kp=300 的纯 PD 稳态会下沉 17 mm / 2.6°，远超兑换柱
         1.9 mm / 1° 的插入容差，place 会被顶飞。只给连杆加，不给
         hollow_cylinder 加——负载重量本来就该压在臂上。 -->
    <body name="link1" gravcomp="1" pos="0.0085 0.0481 0.21">
      <inertial pos="0.00204172 0.0460268 -0.00160657" quat="0.995475 0.0237798 0.0799534 0.0455196" mass="0.760718" diaginertia="0.00120542 0.000939196 0.000802077" />
