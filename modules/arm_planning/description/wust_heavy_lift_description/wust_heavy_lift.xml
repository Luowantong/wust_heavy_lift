        <body name="link3" gravcomp="1" pos="-0.0450914 0.0957955 -0.0160058">
          <inertial pos="-0.0706208 0.108527 -0.0160922" quat="0.922554 0.247232 -0.209012 0.209962" mass="1.35727" diaginertia="0.00443072 0.00411474 0.00211565" />
          <joint name="joint3" range="-3.14 3.14" axis="-0.743141 0.65606 0.131632" />
          <geom type="mesh" rgba="0.898039 0.917647 0.929412 1" mesh="link3_collision" group="3" />
          <geom name="link3_visual" class="visual" mesh="link3_visual" rgba="0.898039 0.917647 0.929412 1" />
          <body name="link4" gravcomp="1" pos="-0.0807636 0.103735 0.0358967">
            <inertial pos="-0.0937964 -0.00599206 0.0525041" quat="0.421501 -0.264353 -0.220054 0.839065" mass="1.0337" diaginertia="0.00356994 0.00321267 0.0013896" />
            <joint name="joint4" range="-3.14 3.14" axis="0.585801 0.542805 0.60183" />
            <geom quat="1 0 0 0" type="mesh" rgba="0.65098 0.619608 0.588235 1" mesh="link4_collision" group="3" />
            <geom name="link4_visual" class="visual" mesh="link4_visual" rgba="0.65098 0.619608 0.588235 1" />
            <body name="link5" gravcomp="1" pos="-0.139292 -0.0288445 0.116557">
              <inertial pos="-0.0259098 -0.0158338 0.0375458" quat="0.335006 -0.190846 -0.29314 0.874881" mass="0.640844" diaginertia="0.000741047 0.000685696 0.000410058" />
              <joint name="joint5" range="-3.14 3.14" axis="0.519891 0.317985 -0.792842" />
              <geom quat="1 0 0 0" type="mesh" rgba="0.898039 0.917647 0.929412 1" mesh="link5_collision" group="3" />
