      <geom name="hollow_wall_11" type="box" pos="-0.01003 -0.02421 0.02250" size="0.00630 0.00646 0.05250" quat="-0.555570 0 0 0.831470" contype="1" conaffinity="1" rgba="0.8 0.5 0.2 0.35"/>
