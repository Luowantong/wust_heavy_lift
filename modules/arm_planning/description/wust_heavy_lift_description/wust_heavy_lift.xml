  </asset>
  <worldbody>
    <camera name="exchange_cam"
        pos="0.00 -0.35 0.80"
        quat="0.808711 0.486231 0.170561 0.283681"
        fovy="50"
        resolution="1280 720"
        mode="fixed"/>
    <body name="hollow_cylinder" pos="0.34 0.0 0.28">
      <freejoint/>
      <inertial pos="0 0 0" mass="0.1" diaginertia="0.0001 0.0001 0.0001"/>
      <!-- 碰撞模型：真单元是空心管，MuJoCo 网格碰撞取凸包会把内孔填死，
           所以用 16 个 box 围出内径 Ø39.8 的孔壁。开口端在 body +z，
           孔深 105 mm（z 从 +0.075 到 -0.030），以下是实心。
           兑换柱 Ø36、孔 Ø39.8 → 单边间隙 1.9 mm，靠接触导正。 -->
      <geom name="hollow_wall_0"  type="box" pos="0.02620 0.00000 0.02250" size="0.00630 0.00646 0.05250" quat="1.000000 0 0 0.000000" contype="1" conaffinity="1" rgba="0.8 0.5 0.2 0.35"/>
      <geom name="hollow_wall_1"  type="box" pos="0.02421 0.01003 0.02250" size="0.00630 0.00646 0.05250" quat="0.980785 0 0 0.195090" contype="1" conaffinity="1" rgba="0.8 0.5 0.2 0.35"/>
