    <position name="pos_J5" joint="joint5" kp="300" kv="3" ctrllimited="true" ctrlrange="-3.14 3.14" forcelimited="true" forcerange="-10 10" />
    <position name="pos_J6" joint="joint6" kp="300" kv="3" ctrllimited="true" ctrlrange="-3.14 3.14" forcelimited="true" forcerange="-10 10" />
    <position name="pos_J7" joint="joint7" kp="300" kv="3" ctrllimited="true" ctrlrange="-3.14 3.14" forcelimited="true" forcerange="-10 10" />
  </actuator>
</mujoco>