  <link name="LINK_TCP">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
    <collision>
      <geometry><box size="0.05 0.05 0.05"/></geometry>     <!-- 旧模型就是这么写的 -->
    </collision>
  </link>
  <link name="camera_link">
    <visual>
      <geometry><box size="0.02 0.05 0.02"/></geometry>     <!-- 旧模型的尺寸 -->
      <material name="blue"><color rgba="0 0 1 1"/></material>
    </visual>
  </link>

  <link name="camera_optical_frame">                           <!-- 不留任何几何体 -->
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base"/>
    <child link="link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="3"/>
  </joint>
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0.02424 0.0072 0.073" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="3"/>
  </joint>
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="-0.22100422 -0.1247 0.21453973" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="3"/>
  </joint>
  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0.072 0.1396 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="3"/>
  </joint>
  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0.112 0.013075 0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="3"/>
  </joint>
  <joint name="joint6" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <origin xyz="0.08050003 -0.0137 0.0135" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="3"/>
  </joint>
  <joint name="joint7" type="revolute">
    <parent link="link6"/>
    <child link="link7"/>
    <origin xyz="0.0715 0 -0.0068" rpy="0 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="3"/>
  </joint>
  <joint name="vacuum_tcp" type="fixed">
    <origin xyz="0.0366 0 -0.081603" rpy="3.1416 0 3.1416"/>
    <parent link="link7"/> <child link="LINK_TCP"/>
  </joint>
  <joint name="camera_joint" type="fixed">
      <origin xyz="0 -0.08 0.04" rpy="3.1416 0 3.1416"/>
      <parent link="link7"/> <child link="camera_link"/>
  </joint>
  <joint name="camera_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="camera_link"/> <child link="camera_optical_frame"/>
  </joint>
</robot>
