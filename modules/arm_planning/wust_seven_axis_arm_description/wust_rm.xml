<?xml version="1.0" encoding="utf-8"?>
<mujoco model="wust_arm2">
    <compiler angle="radian" inertiafromgeom="false" eulerseq="XYZ" meshdir="meshes" />
    <option timestep="0.002" iterations="50" solver="Newton" tolerance="1e-6" />

    <default>
        <joint type="hinge" axis="0 0 1" limited="true" range="-3.1416 3.1416" damping="1.0" armature="0.01" frictionloss="0.05"/>
        <geom condim="3" friction="1 0.005 0.0001"/>
        <default class="visual">
            <geom type="mesh" contype="0" conaffinity="0" group="1" density="0"/>
        </default>
        <default class="collision">
            <geom group="3" contype="1" conaffinity="1"/>
        </default>
    </default>

    <asset>
        <material name="mat_white" rgba="1 1 1 1"/>
        <material name="mat_gray" rgba="0.75294 0.75294 0.75294 1"/>
        <material name="mat_light" rgba="0.89804 0.91765 0.92941 1"/>
        <material name="mat_beige" rgba="0.77647 0.75686 0.73725 1"/>
        <mesh name="base_link" file="base_link.STL"/>
        <mesh name="LINK1" file="LINK1.STL"/>
        <mesh name="LINK2" file="LINK2.STL"/>
        <!-- LINK3 原始 STL 有 299873 面，超过 MuJoCo STL 解码器 200000 面上限；
             已无损转为 OBJ(面/顶点完全一致)，故改用 .obj -->
        <mesh name="LINK3" file="LINK3.obj"/>
        <mesh name="LINK4" file="LINK4.STL"/>
        <mesh name="LINK5" file="LINK5.STL"/>
        <mesh name="LINK6" file="LINK6.STL"/>
        <mesh name="LINK7" file="LINK7.STL"/>
        <!-- 定义纹理 -->
        <texture type="2d" name="checker_floor" builtin="checker" mark="edge" rgb1="0.6 0.8 1.0" rgb2="0.6 0.95 0.6" markrgb="0.2 0.2 0.2" width="512" height="512"/>
        <!-- 定义材质 -->
        <material name="floor_mat" texture="checker_floor" texrepeat="50 50" reflectance="0.1"/>
    </asset>

    <worldbody>
        <!-- 地面 z=0，与 base_link 最低点对齐（底座碰撞体最低点 z=0.000） -->
        <geom name="ground" type="plane" pos="0 0 0" size="10 10 0.1" material="floor_mat" rgba="1 1 1 1"/>

        <body name="base_link" pos="0 0 0">
            <inertial pos="-0.052756 0 0.114" mass="77.643" diaginertia="2.5996 2.5225 4.4493" />
            <geom class="visual" name="base_visual" mesh="base_link" material="mat_white"/>
            <geom class="collision" name="base_col_pillar" type="cylinder" size="0.10 0.08" pos="0 0 0.08"/>
            <geom class="collision" name="base_col_foot" type="cylinder" size="0.18 0.015" pos="0 0 0.015"/>

            <body name="LINK1" pos="0 0 0.228">
                <joint name="JOINT1"/>
                <inertial pos="-0.030637 0.0020368 0.050543" mass="1.2631"
                          fullinertia="0.0011058 0.0023006 0.0020412 -3.0364e-05 5.2822e-05 -1.8449e-08" />
                <geom class="visual" name="link1_visual" mesh="LINK1" material="mat_gray"/>
                <geom class="collision" name="link1_col_joint" type="sphere" size="0.032" pos="0 0 0"/>
                <geom class="collision" name="link1_col_bone" type="capsule" size="0.025"
                      fromto="0.00892864 -0.0205286 0.0269046 0.0137667 -0.0316522 0.0414832"/>

                <body name="LINK2" pos="0.024226 -0.0557 0.073" euler="1.5708 -0.77059 3.1416">
                    <joint name="JOINT2"/>
                    <inertial pos="0.17743949 -0.00252552 -0.00310724" mass="1.82422943"
                              fullinertia="0.00123111 0.00575479 0.00662515 -2.9697e-07 3.9307e-05 7.7012e-09" />
                    <geom class="visual" name="link2_visual" mesh="LINK2" material="mat_light"/>
                    <geom class="collision" name="link2_col_joint" type="sphere" size="0.038" pos="0 0 0"/>
                    <geom class="collision" name="link2_col_bone" type="capsule" size="0.030"
                          fromto="0.0407408 0 0.00460318 0.275209 0 0.031095"/>

                    <body name="LINK3" pos="0.308 0 0.0348" euler="-3.1416 0 2.371">
                        <joint name="JOINT3"/>
                        <inertial pos="0.04032042 0.09633430 -0.05022441" mass="1.87813911"
                                  fullinertia="0.00166748 0.00237489 0.00170345 8.2712e-06 7.2782e-06 4.1448e-06" />
                        <geom class="visual" name="link3_visual" mesh="LINK3" material="mat_gray"/>
                        <geom class="collision" name="link3_col_joint" type="sphere" size="0.030" pos="0 0 0"/>
                        <geom class="collision" name="link3_col_bone" type="capsule" size="0.024"
                              fromto="0.0314545 0 -0.00998075 0.0782645 0 -0.0248339"/>

                        <body name="LINK4" pos="0.104 0 -0.033" euler="1.5708 0 1.5708">
                            <joint name="JOINT4" armature="0.005"/>
                            <inertial pos="-0.00098552 -0.00030265 0.02830966" mass="0.42994598"
                                      fullinertia="0.000144245 0.000169753 0.000168563 1.1144e-08 -4.3403e-08 -2.1439e-08" />
                            <geom class="visual" name="link4_visual" mesh="LINK4" material="mat_white"/>
                            <geom class="collision" name="link4_col_joint" type="sphere" size="0.024" pos="0 0 0"/>
                            <geom class="collision" name="link4_col_bone" type="capsule" size="0.018"
                                  fromto="0 0 0.027 0 0 0.055"/>

                            <body name="LINK5" pos="0 0 0.08" euler="1.5708 -1.5708 0">
                                <joint name="JOINT5" armature="0.005"/>
                                <inertial pos="0.07961672 0.00201853 0.00005787" mass="0.51694292"
                                          fullinertia="0.000195068 0.000527557 0.000459009 -1.1367e-05 -2.6662e-08 -2.7743e-09" />
                                <geom class="visual" name="link5_visual" mesh="LINK5" material="mat_beige"/>
                                <geom class="collision" name="link5_col_joint" type="sphere" size="0.022" pos="0 0 0"/>
                                <geom class="collision" name="link5_col_bone" type="capsule" size="0.016"
                                      fromto="0.0249822 0.00094034 8.77182e-05 0.157015 0.00591011 0.000551317"/>

                                <body name="LINK6" pos="0.178 0.0067 0.000625" euler="1.5708 -1.5708 0">
                                    <joint name="JOINT6" armature="0.005"/>
                                    <inertial pos="0.00005491 -0.02853983 -0.00527210" mass="0.26194751"
                                              fullinertia="0.000132212 0.000158499 0.000089342 3.5250e-08 6.9829e-09 6.8965e-07" />
                                    <geom class="visual" name="link6_visual" mesh="LINK6" material="mat_light"/>
                                    <geom class="collision" name="link6_col_joint" type="sphere" size="0.018" pos="0 0 0"/>
                                    <geom class="collision" name="link6_col_bone" type="capsule" size="0.012"
                                          fromto="0 0.021 0 0 0.0305 0"/>

                                    <body name="LINK7" pos="0 0.0535 0" euler="1.5708 0 0">
                                        <joint name="JOINT7" armature="0.005"/>
                                        <inertial pos="0.000008446 0.000000001 0.0039645" mass="0.63109"
                                                  fullinertia="0.00018068 0.00027815 0.00025894 -2.1762e-06 -7.9769e-09 -5.4956e-11" />
                                        <geom class="visual" name="link7_visual" mesh="LINK7" material="mat_white"/>
                                        <geom class="collision" name="link7_col_joint" type="sphere" size="0.022" pos="0 0 0"/>
                                        <geom class="collision" name="link7_col_ee" type="capsule" size="0.016"
                                              fromto="0 0 0.025 0 0 0.042"/>
                                    </body>
                                </body>
                            </body>
                        </body>
                    </body>
                </body>
            </body>
        </body>
    </worldbody>

    <contact>
        <exclude body1="base_link" body2="LINK1"/>
        <exclude body1="LINK1" body2="LINK2"/>
        <exclude body1="LINK2" body2="LINK3"/>
        <exclude body1="LINK3" body2="LINK4"/>
        <exclude body1="LINK4" body2="LINK5"/>
        <exclude body1="LINK5" body2="LINK6"/>
        <exclude body1="LINK6" body2="LINK7"/>
        <exclude body1="LINK4" body2="LINK6"/>
        <exclude body1="LINK5" body2="LINK7"/>
    </contact>

    <actuator>
        <motor name="act_J1" joint="JOINT1" gear="1" ctrllimited="true" ctrlrange="-8 8" forcelimited="true" forcerange="-8 8" />
        <motor name="act_J2" joint="JOINT2" gear="1" ctrllimited="true" ctrlrange="-40 40" forcelimited="true" forcerange="-40 40" />
        <motor name="act_J3" joint="JOINT3" gear="1" ctrllimited="true" ctrlrange="-20 20" forcelimited="true" forcerange="-20 20" />
        <motor name="act_J4" joint="JOINT4" gear="1" ctrllimited="true" ctrlrange="-8 8" forcelimited="true" forcerange="-8 8" />
        <motor name="act_J5" joint="JOINT5" gear="1" ctrllimited="true" ctrlrange="-8 8" forcelimited="true" forcerange="-8 8" />
        <motor name="act_J6" joint="JOINT6" gear="1" ctrllimited="true" ctrlrange="-6 6" forcelimited="true" forcerange="-6 6" />
        <motor name="act_J7" joint="JOINT7" gear="1" ctrllimited="true" ctrlrange="-4 4" forcelimited="true" forcerange="-4 4" />
    </actuator>
</mujoco>
